# Copy to .env (git-ignored). Use the values of your madAuth server.

# Where the madAuth server sends its calls. This receiver listens on the URL's port.
WEBHOOK_URL=http://localhost:8790/webhook
# Where the madAuth server publishes the public keys of its webhook signatures (v1a). Default: madAuth on its default
# port, http://localhost:8787/.well-known/webhook-keys.json. Set it empty to check WEBHOOK_SECRET alone.
# WEBHOOK_KEYS_URL=http://localhost:8787/.well-known/webhook-keys.json
# Optional: the madAuth server's WEBHOOK_SECRET, for calls signed with it (v1), e.g. of a server without a webhook key.
# WEBHOOK_SECRET=
# Optional: only these e-mail domains may sign up (answers the user.signing_up check).
# ALLOWED_EMAIL_DOMAINS=example.com
