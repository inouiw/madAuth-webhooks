# Copy to .env (git-ignored). Use the same two values as your madAuth server.

# Where the madAuth server sends its calls. This receiver listens on the URL's port.
WEBHOOK_URL=http://localhost:8790/webhook
# The madAuth server's WEBHOOK_SECRET.
WEBHOOK_SECRET=
# Optional: only these e-mail domains may sign up (answers the signup.before check).
# ALLOWED_EMAIL_DOMAINS=example.com
